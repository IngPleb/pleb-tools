<Application x:Class="PlebTools.AppExpose.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <FontFamily x:Key="InterfaceFont">Segoe UI Variable Text, Segoe UI</FontFamily>
        <SolidColorBrush x:Key="TextPrimary" Color="#FF202020" />
        <SolidColorBrush x:Key="TextSecondary" Color="#FF5A5A5A" />
        <SolidColorBrush x:Key="Surface" Color="#EAF2F5F8" />
        <SolidColorBrush x:Key="CardSurface" Color="#F4F6F7F9" />
        <SolidColorBrush x:Key="Selection" Color="#FF4CC2FF" />
    </Application.Resources>
</Application>
