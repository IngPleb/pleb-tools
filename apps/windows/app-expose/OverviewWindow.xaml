<Window x:Class="PlebTools.AppExpose.OverviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="App Exposé"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#E6101010"
        FontFamily="{StaticResource InterfaceFont}"
        Foreground="{StaticResource TextPrimary}"
        PreviewKeyDown="OnPreviewKeyDown"
        Deactivated="OnDeactivated">
    <Grid x:Name="Root" Margin="40,28,40,36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel HorizontalAlignment="Center">
            <TextBlock x:Name="AppName"
                       FontFamily="Segoe UI Variable Display, Segoe UI"
                       FontSize="20"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="WindowCount"
                       Margin="0,4,0,0"
                       FontSize="12"
                       Foreground="{StaticResource TextSecondary}"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <Grid x:Name="WindowGrid" Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <Border Grid.Row="4"
                Padding="12,7"
                CornerRadius="8"
                Background="#B82A2A2A"
                BorderBrush="#2EFFFFFF"
                BorderThickness="1"
                HorizontalAlignment="Center">
            <TextBlock FontSize="11" Foreground="{StaticResource TextSecondary}">
                <Run Text="← ↑ ↓ →" Foreground="{StaticResource TextPrimary}" />
                <Run Text=" select   " />
                <Run Text="Enter" Foreground="{StaticResource TextPrimary}" />
                <Run Text=" open   " />
                <Run Text="Esc" Foreground="{StaticResource TextPrimary}" />
                <Run Text=" dismiss" />
            </TextBlock>
        </Border>
    </Grid>
</Window>
