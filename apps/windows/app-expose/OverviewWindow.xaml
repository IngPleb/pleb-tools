<Window x:Class="PlebTools.AppExpose.OverviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="App Exposé"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        FontFamily="{StaticResource InterfaceFont}"
        Foreground="#FF202020"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        PreviewKeyDown="OnPreviewKeyDown"
        Deactivated="OnDeactivated">
    <Grid x:Name="Root" ClipToBounds="True">
        <Grid x:Name="BackdropLayer" IsHitTestVisible="False">
            <Image x:Name="DesktopBackdrop"
                   Stretch="UniformToFill"
                   RenderTransformOrigin="0.5,0.5">
                <Image.Effect>
                    <BlurEffect Radius="38" KernelType="Gaussian" RenderingBias="Performance" />
                </Image.Effect>
                <Image.RenderTransform>
                    <ScaleTransform ScaleX="1.06" ScaleY="1.06" />
                </Image.RenderTransform>
            </Image>
            <Border Background="#780A0E14" />
            <Border Background="#24000000" />
        </Grid>

        <Canvas x:Name="WindowCanvas" />
    </Grid>
</Window>
