<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- The mixed WPF/WinForms tray app requires the WPF process manifest below;
         WFO0003 assumes a WinForms-only startup path and reports a false conflict. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <AssemblyName>AppExpose</AssemblyName>
    <RootNamespace>PlebTools.AppExpose</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="AppExpose.Tests\**\*.cs" />
    <EmbeddedResource Remove="AppExpose.Tests\**\*" />
    <None Remove="AppExpose.Tests\**\*" />
  </ItemGroup>
</Project>
